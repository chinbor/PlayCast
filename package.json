{
  "name": "live-interaction-tool",
  "version": "0.2.2",
  "private": true,
  "description": "玩播 PlayCast — 多平台直播互动与游戏挑战桌面工具",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5188 && electron . --dev\"",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "smoke": "electron . --smoke",
    "pack:win": "npm run build && electron-builder --config electron-builder.cjs --win --x64 --dir --publish never",
    "dist:win": "npm test && npm run build && electron-builder --config electron-builder.cjs --win nsis --x64 --publish never",
    "verify:package": "node tests/packaged-artifact-smoke.cjs"
  },
  "dependencies": { "react": "^19.1.0", "react-dom": "^19.1.0", "ws": "^8.18.3" },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "electron": "^44.4.5",
    "electron-builder": "26.15.3",
    "unocss": "^66.0.0",
    "vite": "^6.3.0",
    "wait-on": "^8.0.0"
  }
}
