{
  "name": "live-interaction-tool",
  "version": "0.2.3",
  "private": true,
  "description": "玩播 PlayCast — 多平台直播互动与游戏挑战桌面工具",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"node scripts/dev-electron.mjs\"",
    "typecheck": "npm run typecheck:electron && npm run typecheck:renderer && npm run typecheck:tooling",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "prestart": "npm run build",
    "start": "electron .",
    "pretest": "npm run build:electron",
    "test": "node --test tests/*.test.cjs",
    "presmoke": "npm run build:electron",
    "smoke": "electron . --smoke",
    "pack:win": "npm run build && electron-builder --config electron-builder.cjs --win --x64 --dir --publish never",
    "dist:win": "npm test && npm run build && electron-builder --config electron-builder.cjs --win nsis --x64 --publish never",
    "verify:package": "node tests/packaged-artifact-smoke.cjs",
    "report:package": "node scripts/package-report.mjs",
    "benchmark": "node scripts/benchmark.cjs",
    "release:check": "node scripts/check-release.mjs",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json --noEmit",
    "verify:workflows": "node scripts/check-workflows.mjs"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "electron": "^44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.9.3",
    "unocss": "^66.0.0",
    "vite": "^6.3.0",
    "yaml": "^2.8.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
