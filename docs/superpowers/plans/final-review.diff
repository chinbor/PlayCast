+const {createDouyinSession}=require('../../electron/douyin-session.cjs')
+const {createDouyinAdapter}=require('../../electron/platforms.cjs')
+const profile=require('./account-response.cjs')
+let accountId='smoke-user'
+// Real auth state machine and adapter; only network capture and remote responses
+// are fixtures. This never opens or reads the user's real credential storage.
+module.exports=({BrowserWindow,session})=>({onState})=>{
+  const auth=createDouyinSession({BrowserWindow,session,onChange:onState,requestProfile:async()=>{const result=await profile();result.data.sec_uid=accountId;return result}})
+  let status='idle'
+  return createDouyinAdapter({
+    snapshot:()=>({status,auth:auth.snapshot()}),showSession:()=>auth.showLogin(),refreshAuth:()=>auth.verify(),
+    importCredential:value=>auth.importCredential(value),clearCredential:async()=>{status='idle';await auth.clearCredential()},
+    connect(){status='connected';onState()},stop(){status='idle';onState()},dispose(){auth.dispose()},
+    getGifts:async()=>[{platformId:'douyin',giftId:'fixture-heart',name:'娴嬭瘯绀肩墿',icon:'https://avatar.example.invalid/account.png',price:1,currency:'鎶栧竵'},{platformId:'douyin',giftId:'fixture-rose',name:'娴嬭瘯鐜懓',icon:'',price:1,currency:'鎶栧竵'}]
+  })
+}
+module.exports.setAccountId=value=>{accountId=value}
