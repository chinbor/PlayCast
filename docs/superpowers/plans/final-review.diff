+    const api={descriptor:{id,name:id,capabilities:{login:['official-window'],messages:id==='douyin'?['like','follow','gift','comment','enter']:['comment'],giftCatalog:id==='douyin'}},
+      getAccount:()=>account,getState:()=>state,login(){account={status:'authenticated',profile:{id:'a',nickname:'璐﹀彿'}};onState()},refreshAccount(){},logout(){account={status:'signed-out',profile:null};onState()},parseRoom:input=>{if(!/^\d+$/.test(input))throw Error('鎴块棿鏃犳晥');return input},
+      connect(){state={status:'connected'};onState()},disconnect(){state={status:'idle'}},dispose(){},getGiftCatalog:async()=>[{platformId:id,giftId:'1',name:'绀肩墿',icon:'https://example.com/g.png',price:1}],normalize:(e,scope)=>n.normalize(e,scope),exportNormalizer:()=>n.export(),restoreNormalizer:s=>{n=createNormalizer(s)}}
+    handles[id]={event:onEvent,account:value=>{account=value;onState()},api};return api
