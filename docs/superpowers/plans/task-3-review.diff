+import GiftPicker from './GiftPicker'
+
+export const defaultRules=()=>({likesEnabled:true,likeEvery:100,followEnabled:true,follow:1,gifts:[]})
+export function normalizeRules(rules){return {likesEnabled:!!rules.likesEnabled,likeEvery:Number(rules.likeEvery),followEnabled:!!rules.followEnabled,follow:Number(rules.follow),gifts:(rules.gifts||[]).map(g=>({...g,reward:Number(g.reward)}))}}
+
+export default function InteractionRules({rules,onChange,catalog,capabilities,refresh,disabled=false,previousRules}) {
+  const thresholdChanged=previousRules&&(previousRules.likesEnabled!==rules.likesEnabled||Number(previousRules.likeEvery)!==Number(rules.likeEvery))
+  const supports=type=>!capabilities||capabilities.messages?.includes(type)
+  const giftsSupported=supports('gift')&&catalog?.status!=='unsupported'
+  return <div className="interaction-rules"><div className="rules-fields">{supports('like')&&<><label className="rule-toggle"><input type="checkbox" checked={!!rules.likesEnabled} onChange={e=>onChange({...rules,likesEnabled:e.target.checked})}/><span><b>鐐硅禐鍔犵洰鏍?/b><small>姣忚揪鍒版寚瀹氱偣璧炴暟锛岀洰鏍?+1</small></span></label><label>姣忓灏戜釜璧?+1<input data-testid="rules-like-every" type="number" min="1" max="1000000" value={rules.likeEvery} onChange={e=>onChange({...rules,likeEvery:e.target.value===''?'':Number(e.target.value)})}/></label></>}{supports('follow')&&<><label className="rule-toggle"><input type="checkbox" checked={!!rules.followEnabled} onChange={e=>onChange({...rules,followEnabled:e.target.checked})}/><span><b>鍏虫敞鍔犵洰鏍?/b><small>姣忎綅鏂板叧娉ㄧ敤鎴峰彧璁＄畻涓€娆?/small></span></label><label>姣忎綅鍏虫敞澧炲姞<input data-testid="rules-follow-reward" type="number" min="0" max="100000" value={rules.follow} onChange={e=>onChange({...rules,follow:e.target.value===''?'':Number(e.target.value)})}/></label></>}</div>
