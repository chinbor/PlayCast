+  const legacy=!!s.migrationNotice&&!s.configured&&s.status==='paused'
+  return <div className="setup-gameplay"><div className="setup-heading"><span className="setup-kicker">绗?4 姝?路 閫夋嫨鐜╂硶</span><h1>閫変竴涓灞€鎸囨爣锛屽畾濂界洰鏍?/h1><p>寮€鎾悗瑙備紬鐨勭偣璧炪€佸叧娉ㄥ拰绀肩墿浼氬鍔犵洰鏍囷紱娓告垙杩涘害浠庡綋鍓嶅灞€寮€濮嬬粺璁°€?/p></div>
