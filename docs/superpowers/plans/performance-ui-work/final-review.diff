+const {test}=require('node:test'),assert=require('node:assert/strict'),vm=require('node:vm'),fs=require('node:fs'),path=require('node:path'),{EventEmitter}=require('node:events')
+async function fixture(){
+ const handlers={},windows=[],app=new EventEmitter(),calls={flush:0,stop:0,dialogs:0,raw:0};let fail=false,state={source:'live',account:{status:'signed-out'}},contextChanged
+ const product={display:()=>state,overlay:()=>({source:'live'}),query:()=>({private:true}),action(){},game(){},collectorStatus(){},async flush(){calls.flush++;return {error:fail?{category:'write'}:null}},async stop(){calls.stop++;return {error:null}}}
+ class Window extends EventEmitter{constructor(){super();this.webContents=new EventEmitter();this.webContents.setWindowOpenHandler=()=>{};this.webContents.send=name=>{if(name==='collector:snapshot')calls.raw++};windows.push(this)}isDestroyed(){return false}async loadFile(){}show(){}focus(){}}
+ app.getPath=()=>'.';app.requestSingleInstanceLock=()=>true;app.whenReady=()=>Promise.resolve();app.quit=()=>{const e={preventDefault(){this.prevented=true}};app.emit('before-quit',e);if(!e.prevented)calls.quit=true}
+ let time=1000
+ const context={require:id=>id==='electron'?{app,BrowserWindow:Window,ipcMain:{handle:(n,f)=>handlers[n]=f},globalShortcut:{},session:{},safeStorage:{},dialog:{showErrorBox(){calls.dialogs++}}}:id==='./product.cjs'?{createProduct:options=>{contextChanged=options.onContextChange;return product}}:id==='./collector.cjs'?{fetchGame:async()=>({raw:true}),mockGame:()=>null}:require(id),process:{argv:[],env:{}},console,__dirname:path.resolve('electron'),setTimeout:()=>0,clearTimeout(){},setInterval,clearInterval,performance,Date:class extends Date{static now(){return time+=1000}}}
+ vm.runInNewContext(fs.readFileSync('electron/main.cjs','utf8'),context)
+ await new Promise(resolve=>setImmediate(resolve))
+ return {handlers,windows,app,calls,setFailure:value=>{fail=value},setState:value=>{state=value;contextChanged?.()},poll:context.poll}
+}
+test('raw game subscription requires fresh opt-in after auth loss and source/context change',async()=>{
+ const f=await fixture(),sender=f.windows[0].webContents,authenticated={source:'live',account:{status:'authenticated',profile:{id:'alice'}}}
+ f.setState(authenticated);f.handlers['collector:subscribe']({sender},true);await f.poll();assert.equal(f.calls.raw,1)
+ f.setState({...authenticated,account:{...authenticated.account,status:'checking'}});await f.poll()
