+import {useEffect,useState} from 'react'
+export function scopeKey(s){return JSON.stringify([s?.source,s?.platform?.id,s?.account?.status,s?.account?.profile?.id,s?.scope?.platformId,s?.scope?.accountScope,s?.scope?.roomId,s?.setup?.roomConfirmed])}
+export function useQuery(api,type,options={},revision='',enabled=true){
+  const key=JSON.stringify(options),[state,setState]=useState({key:'',data:null,loading:true,error:''})
+  const identity=JSON.stringify([type,key,revision])
+  useEffect(()=>{if(!enabled||!api?.productQuery)return;let current=true;setState({key:identity,data:null,loading:true,error:''});api.productQuery(type,JSON.parse(key)).then(data=>{if(current)setState({key:identity,data,loading:false,error:data===null?'这份记录暂时无法读取，请重试或检查本地存储。':''})},()=>{if(current)setState({key:identity,data:null,loading:false,error:'读取失败，请稍后重试。'})});return()=>{current=false}},[api,type,key,identity,enabled])
+  return state.key===identity?state:{data:null,loading:enabled,error:''}
+}

